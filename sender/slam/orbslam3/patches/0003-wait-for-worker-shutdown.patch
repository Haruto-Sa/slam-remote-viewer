@@ -2512,0 +2513,13 @@ void LoopClosing::RunGlobalBundleAdjustment(Map* pActiveMap, unsigned long nLoop
+void LoopClosing::JoinGlobalBundleAdjustment()
+{
+    // System calls this only after the Loop Closing worker has finished, so it
+    // can no longer replace mpThreadGBA.
+    if(mpThreadGBA)
+    {
+        if(mpThreadGBA->joinable())
+            mpThreadGBA->join();
+        delete mpThreadGBA;
+        mpThreadGBA = NULL;
+    }
+}
